# Optional local n8n URL override; defaults to http://127.0.0.1:5678.
N8N_BASE_URL=http://127.0.0.1:5678

# Local deployment API access. Used only by deploy_workflow.py.
N8N_API_KEY=

# Provider API keys used by deploy_workflow.py to create n8n credentials.
# Runtime workflow requests use n8n's credential store, not these environment values.
OPENREGISTER_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=

# Generated by deployment; required by the optional authenticated webhook helper.
PROJECT3_WEBHOOK_TOKEN=

# Recorded by deployment for local helper execution metadata.
PROJECT3_WORKFLOW_ID=
